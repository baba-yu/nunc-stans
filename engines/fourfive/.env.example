# --- FourFive local config ---

# Model selection moved to PROFILES (Phase D): create one on the Formans
# Profiles screen (or PUT /api/profiles/<id> on the gate) and set it as the
# fourfive-chat default. With no profile configured, the offline mock demo
# answers. CODEV_LLM_PROVIDER / OLLAMA_* / ANTHROPIC_MODEL are retired.

# Local server port (Vite dev server proxies /api here)
PORT=8787

# BYOL credentials stay in the environment — profiles never hold them.
# Needed only when a profile names the anthropic-api provider:
ANTHROPIC_API_KEY=
# Ollama host override when not on the default localhost:11434:
OLLAMA_HOST=
